/**
 * Scanner provides a convenient interface for reading data, such as a file,
 * breaking it into tokens separated by specific split characters.
 */
class Scanner {
  private s = null

  /**
   * Constructor: Initializes a new scanner instance for the specified file.
   * @param file The file object or source to be scanned.
   * @param splitChars The characters used as delimiters to split the token streams.
   */
  public Scanner(file, splitChars)
  {
    this.s = newScanner(file, splitChars)
  }

  /**
   * Advances the scanner to the next token.
   * @return true if there is another token available, false if EOF or an error occurs.
   */
  public next()
  {
    return scanNext(this.s)
  }

  /**
   * Retrieves the most recent token generated by a call to next() as a string.
   * @return The text representation of the current token.
   */
  public text()
  {
    return scanText(this.s)
  }
}
