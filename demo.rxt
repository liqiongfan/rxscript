import std

class A {
  private id = 999.9
  public ok(num){
    println(this.id, num)
  }
}

main() {
  println(sha256(1))
  x = 10
  x *= 10
  println(x %= 6)

  a = A()
  for _, name = range ["aKey", "bKey", "cKey", "dKey"] {
    a.$name = name
  }
  println(obj_props(a), a.aKey)

  for i = 0; i < 10; i++ {
    println(i)
  }

  println(md5(1), md5("1"), 10.0 === "10.00", 10 % 3)
  b = {a: 10}
  k = "a"
  x = [1,2,3,4]
  x[0]=b[k]
  b[k] = 32
  println(x, b)
  println(b[k])
  http = std.Http("get", "https://www.baidu.com", null)
  resp = http.do()
  println(resp.headers())
  println(resp.header("Content-Type"))
  println(resp.headers()["Date"])
  println(resp.data())
  println(resp.statusCode())

  a = A()
  m = "ok"
  invoke(a, m, 0b1010)
  println(isObject(a), objectProps(a))

  for ik, name = range objectMethods(a) {
    println(ik, name)
  }

  println(std.String("%d I Love %s").format(01010, "RXScript"))

  println("1.00005" / 2.5 + "1.0000000000250" + 1e9)

  println(toString(0.90010) / "0.8883")

  total = 0
  v = ["1.1", "1.01", "1.001", "1.0001", "1.00001", "1.000001", "1.0000001", "1.00000001"]
  for _, val = range v {
    total +=  val
  }

  x = 1
  z = "hello"
  println("z's length=", len(z), "v's length=", len(v), "z[4]=", z[4])
  println(x ? "Y" : "false")

  println("total = " + total)

  fw = pipe()
  // println(std.Scanner(1, 2))
  // return 0
  go {
    // data = read(fw[0], 10)
    s = std.Scanner(fw[0], "\n")
    for (s.next()) {
      /*if !s.next() {
        break
      }*/
      println(s.text())
    }
    // println(data)
  }

  for {
    data = std.String("%s--%d\n").format("RXScript", time().Unix())
    if write(fw[1], data) {
      sleep(500.)
    }
  }
}
