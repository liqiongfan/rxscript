import std

main() {
  println("1.00005" / 2.5 + "1.0000000000250" + 1e9)
  println(toString(0.90010) + "0.8883")
  println(toString(0.90010) * "0.8883")
  println(toString(0.90010) / "0.8883")
  println("100" % "8")
  println(0x10, toInt("0x10"))
  println(std.String("%d I Love %s").format(01010, "RXScript"))


  v = ["1.5","1.6", "1.8", "2.11", "3.23", "4.55", "6.66"]
  total = "0.0"
  for _, val = range v {
    total +=  val
    println(val)
  }
  println(total)
}
