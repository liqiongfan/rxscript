class Base {
  private address = "do.1.2"
  public Base() {
    b = 0
    b++
    b--
    println(b)
  }
}

class Animal {
  public address = 2002
}

class Hello : Base, Animal
{
  public id = 0
  public name = "hello"
  public z = 100
  public xz = [1,200,null,this.name,"rx", ["go", "rxengine"]]

  public Hello(id, name)
  {
    this.id = id
    this.name = name
    this.address = "false--e"
  }

  public doMoney(num) {
    println("this.xz[3]=", this.xz[3])
    println("hello golang", num, this.xz[3], this.xz[5][0], this.name[0])
    this.name2 = 9
    this.name2 = this.id-=5/5
    println("this.name2:", this.name2)

    tr = getTimeResource()
    println(tr.Format("2006-01-02 15:04:05") + " hello")

    t = getTimeResource("2026-10-16 15:27:30")
    loc = getLocation("America/Los_Angeles")
    println(t.In(loc).Format("2006-01-02 15:04:05"))

    v = listDir(".")
    // println("listDir: ", v[0], v[1], v[2], v[3])
    for index, va = range v {
      if index == 1 {
        // return va
      } else {
        // return va
      }
      println("index: " + index, "value: " + va)
    }

    for name, value = range this.xz {
      println("name: ", name, " value: ", value)
    }

    println((this.name2 && this.id > 100) ? this.z : this.name)

    if this.id < 10 {
      println(this.name + " script is very excellent")
    } else if this.name2 {
      println("this.name2 running")
    } else {
      println("go")
      println("script first.")
    }

    println("50" - "30")
    println(this.getMoney()+2.58)
    println("50" - "33")
    println(this.id, this.name, this.address)
    println(this.printlnGetAddress(getAddress))
  }

  public getMoney() {
    return .05
  }

  private printlnGetAddress(p) {
    x = p(" 100")
    return x
  }

  public sayHello() {
    println("hello sayHello")
  }
}

getAddress(ver) {
  return "hello address --- getAddress" + ver
}

