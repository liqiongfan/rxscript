    defer { waitDone(wg) }
    storeAtomicInt(atomic, readAtomicInt(atomic) + 10)
    println("goroutine8")
    println("goroutine9")
    println("b=", b, " atomic=", readAtomicInt(atomic))
  }

  waitOk(wg)

